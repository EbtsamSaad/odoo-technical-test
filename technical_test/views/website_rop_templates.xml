<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="website_rop_header_menu"
        inherit_id="website.template_header_default"
        name="ROP Header Menu"
        priority="30">

        <xpath expr="//t[@t-foreach='website.menu_id.child_id']"
               position="after">
            <t t-if="request.env.user.has_group('base.group_system')
                     or request.env.user.has_group('stock.group_stock_manager')
                     or request.env.user.has_group('stock.group_stock_user')">
                <li class="nav-item">
                    <a href="/shop/rop"
                       class="nav-link">
                        ROP
                    </a>
                </li>
            </t>
        </xpath>
    </template>

    <template id="website_rop_products" name="ROP Products">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure o_website_rop">
                <section class="container py-5">

                    <h2>ROP Products</h2>
                    <p class="text-muted">
                        Products with quantity on hand below 5 units.
                    </p>

                    <div class="row g-4 mt-3">
                        <t t-foreach="products" t-as="product">
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <div class="card h-100 shadow-sm">
                                    <img t-att-src="'/web/image/product.product/%s/image_256' % product.id"
                                         class="card-img-top"
                                         style="height: 200px; object-fit: contain;"
                                         alt="Product"/>
                                    <div class="card-body">
                                        <h5 t-esc="product.display_name"/>
                                        <p class="text-danger">
                                            Quantity:
                                            <strong t-esc="product.qty_available"/>
                                        </p>
                                        <button type="button"
                                            class="btn btn-primary w-100 mt-2 js_update_rop_qty"
                                            t-att-data-product-id="product.id"
                                            t-att-data-product-name="product.display_name">
                                            Update Product Quantity
                                    </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="not products">
                            <div class="alert alert-info">
                                No products currently have quantity below 5
                            </div>
                        </t>

                        <dialog id="ropQuantityModal"
                                class="rop-quantity-dialog border-0 rounded-3 shadow p-0">
                            <div class="p-3">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h5 class="mb-0 fs-6 fw-bold">
                                        Update Product Quantity
                                    </h5>
                                    <button type="button"
                                            class="btn-close js_close_rop_modal"
                                            aria-label="Close"/>
                                </div>
                                <div class="mb-3">
                                    <div id="ropProductName"
                                         class="text-muted small mb-2"/>
                                    <label for="ropNewQuantity"
                                           class="form-label small fw-semibold">
                                        New Quantity on Hand
                                    </label>
                                    <input type="number"
                                           id="ropNewQuantity"
                                           class="form-control"
                                           min="0"
                                           step="1"/>
                                </div>
                                <div id="ropQuantityError"
                                     class="alert alert-danger small d-none"/>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm js_close_rop_modal">
                                        Cancel
                                    </button>
                                    <button type="button"
                                            id="ropSaveQuantity"
                                            class="btn btn-primary btn-sm">
                                        Apply Quantity
                                    </button>
                                </div>
                            </div>
                        </dialog>

                    </div>

                </section>
            </div>
        </t>
    </template>

</odoo>