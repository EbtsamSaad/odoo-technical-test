<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_template_form_view_rop" model="ir.ui.view">
        <field name="name">product.template.form.rop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='barcode']" position="after">
                <field name="has_rop"/>
                <field name="rop_count"
                       invisible="not has_rop"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_same_rop_products"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="not has_rop">

                    <field name="same_rop_product_count"
                           widget="statinfo"
                           string="Same ROP Products"/>

                </button>
            </xpath>

        </field>
    </record>

</odoo>